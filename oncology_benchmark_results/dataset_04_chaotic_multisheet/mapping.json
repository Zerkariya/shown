{"title":"Mixed-source copy-number review","title_zh":"多来源拷贝数核查","genome":"hg38","group_by":"zl_cd",
 "hide_attributes":["hospital_fake","tel_fake","fake_name","Unnamed: 4","col_7"],
 "tables":[
  {"file":"input/audit_export_38cols.tsv","kind":"patients",
   "columns":{"patient":"PatientKey","purity":"purity_pct","ploidy":"psi","sex":"xingbie"},
   "exclude":["hospital_fake","tel_fake","fake_name","Unnamed: 4","col_7"]},
  {"file":"input/specimens_review.xlsx","sheet":"Clinical notes","kind":"patients",
   "columns":{"patient":"患者编号"},"transforms":{"patient":{"op":"strip_prefix","value":"P-"}},
   "row_filter":[{"column":"nl(%)","op":"nonempty"}],
   "attributes":["bh","备注","F12","测序批次"]},
  {"file":"arm_summary.csv","kind":"patients","columns":{"patient":"patient"}},
  {"file":"input/片段_本地流程.csv","kind":"segments","delimiter":";",
   "columns":{"patient":"zl_cd","chrom":"区域_GRCh38","start":"区域_GRCh38","end":"区域_GRCh38",
              "major_cn":"V3","minor_cn":"V3","logr":"对数比(逗号小数)"},
   "transforms":{"chrom":{"op":"regex","pattern":"^([^:]+):(\\d+)-(\\d+)$","group":1},
                 "start":{"op":"regex","pattern":"^([^:]+):(\\d+)-(\\d+)$","group":2},
                 "end":{"op":"regex","pattern":"^([^:]+):(\\d+)-(\\d+)$","group":3},
                 "major_cn":{"op":"regex","pattern":"^(\\d+)\\D+(\\d+)$","group":1},
                 "minor_cn":{"op":"regex","pattern":"^(\\d+)\\D+(\\d+)$","group":2},
                 "logr":{"op":"replace","old":",","new":"."}}}],
 "attributes":{"zl_cd":{"label":"Tumor type","label_zh":"肿瘤类型"},"年龄":{"label":"Age","label_zh":"年龄","type":"numeric","unit":"y","unit_zh":"岁"},
  "xingbie":{"label":"Sex","label_zh":"性别"},"stage":{"label":"Stage","label_zh":"分期","type":"ordinal","order":["I","II","III","IV"]},
  "bh":{"label":"bh (review sheet, likely ploidy)","label_zh":"bh（审核表，疑似倍性）","type":"numeric"},
  "arm_CN_median":{"label":"Arm CN median (arm sheet)","label_zh":"臂水平 CN 中位数","type":"numeric"},
  "arms_gained":{"label":"Arms gained (arm sheet)","label_zh":"获得的臂数","type":"numeric"},
  "arms_lost":{"label":"Arms lost (arm sheet)","label_zh":"缺失的臂数","type":"numeric"}}}
